# Copy this file to .env and fill in every value. Never commit .env.
# Generate a password: openssl rand -hex 24

# Superuser "postgres". Used for the first initialization and administration only.
POSTGRES_PASSWORD=

# Role "accessflow_owner": owns the accessflow database, runs migrations.
ACCESSFLOW_OWNER_PASSWORD=

# Role "accessflow_app": used by the API at runtime, data access only (no DDL).
ACCESSFLOW_APP_PASSWORD=

# Role "keycloak": used by Keycloak, has access to its own database only.
KEYCLOAK_DB_PASSWORD=

# Keycloak administrator "admin" (master realm). Used for the admin console.
KEYCLOAK_ADMIN_PASSWORD=
