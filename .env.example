# Copy this file to .env and fill in every value. Never commit .env.
# Generate a password: openssl rand -hex 24

# Superuser "postgres". Used for the first initialization and administration only.
POSTGRES_PASSWORD=

# Role "accessflow_owner": owns the accessflow database, runs migrations.
ACCESSFLOW_OWNER_PASSWORD=

# Role "accessflow_app": used by the API at runtime, data access only (no DDL).
ACCESSFLOW_APP_PASSWORD=

# Role "keycloak": used by Keycloak, has access to its own database only.
KEYCLOAK_DB_PASSWORD=

# Keycloak administrator "admin" (master realm). Used for the admin console.
KEYCLOAK_ADMIN_PASSWORD=

# API settings for a local run against the dev stack.
ACCESSFLOW_DATABASE_HOST=127.0.0.1
ACCESSFLOW_DATABASE_PORT=5432
ACCESSFLOW_DATABASE_NAME=accessflow
ACCESSFLOW_DATABASE_USER=accessflow_app
# The same value as ACCESSFLOW_APP_PASSWORD.
ACCESSFLOW_DATABASE_PASSWORD=
# Access tokens: the issuer must equal the "iss" claim of Keycloak tokens exactly.
ACCESSFLOW_AUTH_ISSUER=http://localhost:8081/realms/accessflow
ACCESSFLOW_AUTH_JWKS_URL=http://localhost:8081/realms/accessflow/protocol/openid-connect/certs
